@*
    Họ và tên: Hoàng Dương
    Mã sinh viên: 23103100117
    Module: 5 - Lịch phỏng vấn và Kết quả tuyển dụng
    Nội dung: Danh sách kết quả đánh giá tuyển dụng
*@
@model IEnumerable<QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.KetQuaTuyenDung>

@{
    ViewData["Title"] = "Kết quả tuyển dụng";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">Kết Quả Tuyển Dụng</h3>
            <p class="text-muted small mb-0">Bảng tổng hợp điểm số và quyết định tuyển dụng của Hội đồng</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 70px;">Mã KQ</th>
                            <th>Ứng viên</th>
                            <th>Vị trí ứng tuyển</th>
                            <th class="text-center">Điểm đánh giá</th>
                            <th>Nhận xét hội đồng</th>
                            <th class="text-center">Kết quả</th>
                            <th class="text-center">Ngày đánh giá</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có kết quả tuyển dụng nào được ghi nhận.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaKetQua</td>
                                    <td>
                                        <div class="fw-semibold text-primary">@item.HoSoUngTuyen?.UngVien?.HoTen</div>
                                        <small class="text-muted">Hồ sơ: #@item.MaHoSo</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.HoSoUngTuyen?.ViTriTuyenDung?.TenViTri</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary fs-6">@item.DiemDanhGia.ToString("0.0")</span>
                                    </td>
                                    <td class="text-truncate" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(item.NhanXet) ? "Không có nhận xét." : item.NhanXet)
                                    </td>
                                    <td class="text-center">
                                        @if (item.KetQua == "Trúng tuyển")
                                        {
                                            <span class="badge bg-success">Trúng tuyển</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Không trúng tuyển</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @item.NgayCapNhat.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.MaKetQua" class="btn btn-outline-warning btn-sm text-dark">
                                            Sửa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>