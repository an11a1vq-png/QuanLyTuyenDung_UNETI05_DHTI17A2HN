<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Tuyển Dụng UNETI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyTuyenDung_UNETI05_DHTI17A2HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3 py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-briefcase-fill me-1"></i>Tuyển Dụng UNETI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="ViTriTuyenDung" asp-action="ViecLam">
                                <i class="bi bi-search me-1"></i>Tìm việc làm
                            </a>
                        </li>

                        @* Menu Quản trị gộp 5 Module *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownAdmin" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-fill me-1"></i>Quản trị hệ thống
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="navbarDropdownAdmin">
                                <li><h6 class="dropdown-header text-uppercase">Tuyển dụng</h6></li>
                                <li><a class="dropdown-item" asp-controller="ViTriTuyenDung" asp-action="DanhSachViTri"><i class="bi bi-list-task me-2"></i>Vị trí tuyển dụng (Mod 2)</a></li>
                                <li><a class="dropdown-item" asp-controller="HoSoUngTuyen" asp-action="QuanLyDanhSach"><i class="bi bi-file-earmark-person me-2"></i>Sơ tuyển hồ sơ (Mod 3)</a></li>
                                <li><a class="dropdown-item" asp-controller="LichPhongVan" asp-action="Index"><i class="bi bi-calendar-check me-2"></i>Lịch phỏng vấn (Mod 5)</a></li>
                                <li><a class="dropdown-item" asp-controller="KetQuaTuyenDung" asp-action="Index"><i class="bi bi-trophy me-2"></i>Kết quả tuyển dụng (Mod 5)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header text-uppercase">Hệ thống</h6></li>
                                <li><a class="dropdown-item" asp-controller="PhongBan" asp-action="DanhSachPhongBan"><i class="bi bi-building me-2"></i>Quản lý phòng ban (Mod 1)</a></li>
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DanhSachTaiKhoan"><i class="bi bi-people me-2"></i>Quản lý tài khoản (Mod 1)</a></li>
                                <li><a class="dropdown-item" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Báo cáo thống kê</a></li>
                            </ul>
                        </li>
                    </ul>

                    @* Tích hợp thanh đăng nhập/đăng xuất/Session của bạn An *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3 bg-light">
        <div class="container-fluid px-4 text-center">
            &copy; 2026 - QuanLyTuyenDung_UNETI05_DHTI17A2HN - Nhóm 5 Lớp DHTI17A2HN
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>