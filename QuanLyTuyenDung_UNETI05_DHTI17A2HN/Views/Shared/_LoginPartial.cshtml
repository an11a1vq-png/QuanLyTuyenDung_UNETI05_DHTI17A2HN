@*
    Họ và tên: Đỗ Thiện An
    Mã sinh viên: 23103100082
    Module: 1 - Tài khoản, Đăng nhập, Phân quyền và Phòng ban
    Nội dung: Partial view hiển thị trạng thái đăng nhập, thông tin người dùng và phân quyền Session (_LoginPartial.cshtml)
*@
@using QuanLyTuyenDung_UNETI05_DHTI17A2HN.Helpers

<ul class="navbar-nav ms-auto align-items-center">
@if (Context.Session.IsLoggedIn())
{
    var hoTen = Context.Session.GetHoTen() ?? "Người dùng";
    var vaiTro = Context.Session.GetVaiTro() ?? string.Empty;
    var badgeClass = vaiTro switch
    {
        "Admin" => "bg-danger",
        "Nhân sự" => "bg-primary",
        _ => "bg-success"
    };

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle fs-5 text-secondary"></i>
            <span>@hoTen</span>
            <span class="badge @badgeClass rounded-pill">@vaiTro</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" aria-labelledby="userDropdown">
            <li class="dropdown-header text-muted small">TÀI KHOẢN HIỆN TẠI</li>
            <li><span class="dropdown-item-text fw-semibold">@hoTen</span></li>
            <li><span class="dropdown-item-text small text-muted"><i class="bi bi-shield-check me-1"></i>Vai trò: @vaiTro</span></li>
            <li><hr class="dropdown-divider"></li>
            
            @if (vaiTro == "Ứng viên")
            {
                <li>
                    <a class="dropdown-item" asp-controller="UngVien" asp-action="CapNhatHoSo">
                        <i class="bi bi-person-vcard me-2"></i>Hồ sơ cá nhân
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="HoSoUngTuyen" asp-action="HoSoCuaToi">
                        <i class="bi bi-journal-check me-2"></i>Hồ sơ đã nộp
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            else if (vaiTro == "Admin")
            {
                <li>
                    <a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DanhSachTaiKhoan">
                        <i class="bi bi-people me-2"></i>Quản trị tài khoản
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="PhongBan" asp-action="DanhSachPhongBan">
                        <i class="bi bi-building me-2"></i>Quản lý phòng ban
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
             
            <li>
                <a class="dropdown-item text-danger fw-semibold" asp-controller="TaiKhoan" asp-action="DangXuat">
                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                </a>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-primary btn-sm px-3" asp-controller="TaiKhoan" asp-action="DangNhap">
            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm px-3 shadow-sm text-white" asp-controller="TaiKhoan" asp-action="DangKy">
            <i class="bi bi-person-plus me-1"></i>Đăng ký
        </a>
    </li>
}
</ul>
