@*
    Họ và tên: Nguyễn Tấn Dũng
    Mã sinh viên: 23103100070
    Module: 3 - Quản lý ứng viên và nộp hồ sơ ứng tuyển
    Nội dung: Màn hình form nộp hồ sơ ứng tuyển vào vị trí công việc
*@
@model QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.HoSoUngTuyen

@{
    ViewData["Title"] = "Nộp hồ sơ ứng tuyển";
    var viTri = ViewBag.ViTri as QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.ViTriTuyenDung;
    var ungVien = ViewBag.UngVien as QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.UngVien;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-send-check"></i> Ứng tuyển vị trí: @viTri?.TenViTri</h4>
        </div>
        <div class="card-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="alert alert-info">
                <p class="mb-1"><strong>Phòng ban:</strong> @viTri?.PhongBan?.TenPhongBan</p>
                <p class="mb-1"><strong>Hạn nộp hồ sơ:</strong> @viTri?.HanNopHoSo.ToString("dd/MM/yyyy")</p>
                <p class="mb-0"><strong>Ứng viên nộp:</strong> @ungVien?.HoTen (@ungVien?.Email - @ungVien?.SoDienThoai)</p>
            </div>

            <form asp-action="NopHoSo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaViTri" />
                <input type="hidden" asp-for="MaUngVien" />

                <div class="mb-3">
                    <label asp-for="ThuGioiThieu" class="form-label fw-bold">Thư giới thiệu / Đơn ứng tuyển</label>
                    <textarea asp-for="ThuGioiThieu" rows="5" class="form-control" placeholder="Viết lý do bạn ứng tuyển, điểm mạnh phù hợp với vị trí này..."></textarea>
                    <span asp-validation-for="ThuGioiThieu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GhiChu" class="form-label fw-bold">Ghi chú thêm (Link CV online, Portfolio...)</label>
                    <input asp-for="GhiChu" class="form-control" placeholder="Ví dụ: Link Google Drive CV, GitHub..." />
                    <span asp-validation-for="GhiChu" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Xác nhận nộp hồ sơ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
