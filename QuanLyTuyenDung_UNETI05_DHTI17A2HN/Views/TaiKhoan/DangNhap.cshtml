@*
    Họ và tên: Đỗ Thiện An
    Mã sinh viên: 23103100082
    Module: 1 - Tài khoản, Đăng nhập, Phân quyền và Phòng ban
    Nội dung: Màn hình Đăng nhập hệ thống phân quyền (/TaiKhoan/DangNhap)
*@
@model QuanLyTuyenDung_UNETI05_DHTI17A2HN.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h4 class="mb-1 fw-bold"><i class="bi bi-shield-lock me-2"></i>ĐĂNG NHẬP</h4>
                    <p class="mb-0 small text-white-50">Hệ thống Quản lý Tuyển dụng & Hồ sơ Ứng viên</p>
                </div>
                <div class="card-body p-4 p-md-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="DangNhap" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold">
                                <i class="bi bi-person me-1"></i>Tên đăng nhập
                            </label>
                            <input asp-for="TenDangNhap" class="form-control form-control-lg" placeholder="Nhập tên đăng nhập..." autofocus />
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold">
                                <i class="bi bi-key me-1"></i>Mật khẩu
                            </label>
                            <input asp-for="MatKhau" type="password" class="form-control form-control-lg" placeholder="Nhập mật khẩu..." />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted">Chưa có tài khoản ứng viên?</span>
                        <a asp-action="DangKy" asp-controller="TaiKhoan" class="fw-bold text-decoration-none ms-1">
                            Đăng ký ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khung thông tin tài khoản demo kiểm thử (Mục 16) -->
            <div class="card mt-4 border-0 shadow-sm bg-light rounded-4">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-secondary mb-2 text-center">
                        <i class="bi bi-info-circle me-1"></i>Tài khoản kiểm thử nhanh (Mục 16):
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0 small">
                            <tbody>
                                <tr>
                                    <td><span class="badge bg-danger">Admin</span></td>
                                    <td><code>admin</code></td>
                                    <td>Mật khẩu: <code>123</code></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary">Nhân sự</span></td>
                                    <td><code>hr1</code>, <code>hr2</code></td>
                                    <td>Mật khẩu: <code>123</code></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-success">Ứng viên</span></td>
                                    <td><code>ungvien1</code> ... <code>ungvien30</code></td>
                                    <td>Mật khẩu: <code>123</code></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
