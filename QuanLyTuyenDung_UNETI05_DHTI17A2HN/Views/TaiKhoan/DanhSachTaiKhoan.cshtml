@*
    Họ và tên: Đỗ Thiện An
    Mã sinh viên: 23103100082
    Module: 1 - Tài khoản, Đăng nhập, Phân quyền và Phòng ban
    Nội dung: Màn hình Quản trị danh sách tài khoản người dùng (/TaiKhoan/DanhSachTaiKhoan)
*@
@model IEnumerable<QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.TaiKhoan>
@using QuanLyTuyenDung_UNETI05_DHTI17A2HN.Helpers

@{
    ViewData["Title"] = "Quản lý tài khoản hệ thống";
    var currentAdminId = Context.Session.GetMaTaiKhoan();
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill me-2"></i>Quản lý tài khoản hệ thống
            </h3>
            <p class="text-muted small mb-0">Quản trị viên quản lý danh sách, tìm kiếm, lọc và phân quyền tài khoản</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh tìm kiếm và bộ lọc vai trò bằng LINQ -->
    <div class="card border-0 shadow-sm mb-4 rounded-3">
        <div class="card-body p-3">
            <form asp-action="DanhSachTaiKhoan" method="get" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" 
                               class="form-control border-start-0" placeholder="Tìm theo tên đăng nhập, họ tên hoặc email..." />
                    </div>
                </div>

                <div class="col-md-4 col-lg-3">
                    <select name="vaiTro" class="form-select">
                        <option value="">-- Tất cả vai trò --</option>
                        @if (ViewBag.DanhSachVaiTro != null)
                        {
                            foreach (var vt in (string[])ViewBag.DanhSachVaiTro)
                            {
                                if (ViewBag.CurrentRole == vt)
                                {
                                    <option value="@vt" selected>@vt</option>
                                }
                                else
                                {
                                    <option value="@vt">@vt</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    <a asp-action="DanhSachTaiKhoan" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách tài khoản -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="ps-3 py-3" style="width: 70px;">Mã</th>
                            <th class="py-3">Tên đăng nhập</th>
                            <th class="py-3">Họ và tên</th>
                            <th class="py-3">Email</th>
                            <th class="py-3 text-center">Vai trò</th>
                            <th class="py-3 text-center">Trạng thái</th>
                            <th class="py-3 text-end pe-4" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@item.MaTaiKhoan</td>
                                    <td>
                                        <span class="fw-semibold text-dark">@item.TenDangNhap</span>
                                        @if (item.MaTaiKhoan == currentAdminId)
                                        {
                                            <span class="badge bg-secondary ms-1">Đang đăng nhập</span>
                                        }
                                    </td>
                                    <td>@item.HoTen</td>
                                    <td>
                                        <a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a>
                                    </td>
                                    <td class="text-center">
                                        @if (item.VaiTro == "Admin")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-1">Admin</span>
                                        }
                                        else if (item.VaiTro == "Nhân sự")
                                        {
                                            <span class="badge bg-primary rounded-pill px-3 py-1">Nhân sự</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-1">Ứng viên</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                                <i class="bi bi-lock me-1"></i>Bị khóa
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.MaTaiKhoan != currentAdminId)
                                        {
                                            <form asp-action="KhoaTaiKhoan" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn @(item.TrangThai ? "khóa" : "mở khóa") tài khoản @item.TenDangNhap?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.MaTaiKhoan" />
                                                @if (item.TrangThai)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Khóa tài khoản">
                                                        <i class="bi bi-lock-fill me-1"></i>Khóa
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa tài khoản">
                                                        <i class="bi bi-unlock-fill me-1"></i>Mở khóa
                                                    </button>
                                                }
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Chính bạn</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
