@*
    Họ và tên: Đỗ Thiện An
    Mã sinh viên: 23103100082
    Module: 1 - Tài khoản, Đăng nhập, Phân quyền và Phòng ban
    Nội dung: Màn hình Đăng ký tài khoản Ứng viên (/TaiKhoan/DangKy)
*@
@model QuanLyTuyenDung_UNETI05_DHTI17A2HN.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản ứng viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white text-center py-4 rounded-top-4">
                    <h4 class="mb-1 fw-bold"><i class="bi bi-person-plus me-2"></i>ĐĂNG KÝ TÀI KHOẢN</h4>
                    <p class="mb-0 small text-white-50">Tạo tài khoản ứng viên để tham gia ứng tuyển việc làm</p>
                </div>
                <div class="card-body p-4 p-md-5">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="DangKy" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="TenDangNhap" class="form-label fw-semibold">
                                    <i class="bi bi-person-badge me-1"></i>Tên đăng nhập <span class="text-danger">*</span>
                                </label>
                                <input asp-for="TenDangNhap" class="form-control" placeholder="Tên đăng nhập (tối thiểu 3 ký tự)..." />
                                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MatKhau" class="form-label fw-semibold">
                                    <i class="bi bi-key me-1"></i>Mật khẩu <span class="text-danger">*</span>
                                </label>
                                <input asp-for="MatKhau" type="password" class="form-control" placeholder="Mật khẩu..." />
                                <span asp-validation-for="MatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="XacNhanMatKhau" class="form-label fw-semibold">
                                    <i class="bi bi-shield-check me-1"></i>Xác nhận mật khẩu <span class="text-danger">*</span>
                                </label>
                                <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu..." />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="HoTen" class="form-label fw-semibold">
                                    <i class="bi bi-person me-1"></i>Họ và tên <span class="text-danger">*</span>
                                </label>
                                <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn A..." />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="bi bi-envelope me-1"></i>Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com..." />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-semibold">
                                    <i class="bi bi-telephone me-1"></i>Số điện thoại <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="Ví dụ: 0912345678..." />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-2"></i>Đăng ký tài khoản
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted">Đã có tài khoản?</span>
                        <a asp-action="DangNhap" asp-controller="TaiKhoan" class="fw-bold text-decoration-none ms-1">
                            Đăng nhập ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
