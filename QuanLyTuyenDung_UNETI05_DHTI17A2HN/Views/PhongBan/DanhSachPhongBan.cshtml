@*
    Họ và tên: Đỗ Thiện An
    Mã sinh viên: 23103100082
    Module: 1 - Tài khoản, Đăng nhập, Phân quyền và Phòng ban
    Nội dung: Màn hình Quản lý danh sách phòng ban (/PhongBan/DanhSachPhongBan)
*@
@model IEnumerable<QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.PhongBan>
@using QuanLyTuyenDung_UNETI05_DHTI17A2HN.Helpers

@{
    ViewData["Title"] = "Quản lý danh sách phòng ban";
    var laAdmin = Context.Session.GetVaiTro() == "Admin";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-building me-2"></i>Quản lý danh sách phòng ban
            </h3>
            <p class="text-muted small mb-0">Theo dõi, tìm kiếm và phân cấp phòng ban trong hệ thống tuyển dụng</p>
        </div>
        @if (laAdmin)
        {
            <a asp-action="ThemMoiPhongBan" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Thêm mới phòng ban
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh tìm kiếm và bộ lọc trạng thái LINQ -->
    <div class="card border-0 shadow-sm mb-4 rounded-3">
        <div class="card-body p-3">
            <form asp-action="DanhSachPhongBan" method="get" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" 
                               class="form-control border-start-0" placeholder="Tìm theo tên phòng ban hoặc mô tả..." />
                    </div>
                </div>

                <div class="col-md-4 col-lg-3">
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        @if (ViewBag.CurrentTrangThai == true)
                        {
                            <option value="true" selected>Đang hoạt động</option>
                        }
                        else
                        {
                            <option value="true">Đang hoạt động</option>
                        }

                        @if (ViewBag.CurrentTrangThai == false)
                        {
                            <option value="false" selected>Ngưng hoạt động</option>
                        }
                        else
                        {
                            <option value="false">Ngưng hoạt động</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    <a asp-action="DanhSachPhongBan" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách phòng ban -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="ps-3 py-3" style="width: 70px;">Mã</th>
                            <th class="py-3">Tên phòng ban</th>
                            <th class="py-3">Mô tả</th>
                            <th class="py-3">Email liên hệ</th>
                            <th class="py-3 text-center">Vị trí tuyển dụng</th>
                            <th class="py-3 text-center">Trạng thái</th>
                            <th class="py-3 text-end pe-4" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy phòng ban nào phù hợp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                var soViTri = item.DanhSachViTri?.Count ?? 0;
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@item.MaPhongBan</td>
                                    <td>
                                        <a asp-action="ChiTietPhongBan" asp-route-id="@item.MaPhongBan" 
                                           class="fw-bold text-decoration-none text-primary">
                                            @item.TenPhongBan
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            @(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : (item.MoTa.Length > 60 ? item.MoTa.Substring(0, 60) + "..." : item.MoTa))
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.EmailLienHe))
                                        {
                                            <a href="mailto:@item.EmailLienHe" class="text-decoration-none small">
                                                <i class="bi bi-envelope me-1"></i>@item.EmailLienHe
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">--</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info-subtle text-info border border-info rounded-pill px-3">
                                            @soViTri vị trí
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">
                                                <i class="bi bi-pause-circle me-1"></i>Ngưng
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="ChiTietPhongBan" asp-route-id="@item.MaPhongBan" 
                                               class="btn btn-outline-secondary" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (laAdmin)
                                            {
                                                <a asp-action="CapNhatPhongBan" asp-route-id="@item.MaPhongBan" 
                                                   class="btn btn-outline-primary" title="Cập nhật">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <form asp-action="ToggleTrangThai" asp-route-id="@item.MaPhongBan" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning" 
                                                            title="@(item.TrangThai ? "Chuyển sang Ngưng hoạt động" : "Kích hoạt lại")">
                                                        <i class="bi @(item.TrangThai ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                                    </button>
                                                </form>

                                                <form asp-action="XoaPhongBan" asp-route-id="@item.MaPhongBan" method="post" class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng ban \'@item.TenPhongBan\'?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Xóa phòng ban">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
