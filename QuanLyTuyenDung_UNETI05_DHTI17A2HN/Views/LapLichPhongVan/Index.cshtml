@*
    Họ và tên: Hoàng Dương
    Mã sinh viên: 23103100117
    Module: 5 - Lịch phỏng vấn và Kết quả tuyển dụng
    Nội dung: Danh sách lịch phỏng vấn của ứng viên
*@
@model IEnumerable<QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.LichPhongVan>

@{
    ViewData["Title"] = "Danh sách lịch phỏng vấn";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">Quản lý Lịch Phỏng Vấn</h3>
            <p class="text-muted small mb-0">Theo dõi kế hoạch phỏng vấn và điều phối ứng viên</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 70px;">Mã PV</th>
                            <th>Họ tên ứng viên</th>
                            <th>Vị trí ứng tuyển</th>
                            <th>Thời gian phỏng vấn</th>
                            <th>Hình thức & Địa điểm</th>
                            <th>Người phỏng vấn</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Hiện tại chưa có lịch phỏng vấn nào được thiết lập.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaLichPhongVan</td>
                                    <td>
                                        <div class="fw-semibold text-primary">@item.HoSoUngTuyen?.UngVien?.HoTen</div>
                                        <small class="text-muted">Hồ sơ: #@item.MaHoSo</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.HoSoUngTuyen?.ViTriTuyenDung?.TenViTri</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</div>
                                        <small class="text-muted">Đến: @item.ThoiGianKetThuc.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border mb-1">@item.HinhThucPhongVan</span>
                                        <div class="small text-truncate" style="max-width: 200px;">@item.DiaDiemHoacLienKet</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.NguoiPhongVan</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Đã hoàn thành")
                                        {
                                            <span class="badge bg-success">Đã hoàn thành</span>
                                        }
                                        else if (item.TrangThai == "Đã lên lịch")
                                        {
                                            <span class="badge bg-primary">Đã lên lịch</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Đã lên lịch")
                                        {
                                            <a asp-action="HoanThanh" asp-route-id="@item.MaLichPhongVan" class="btn btn-outline-success btn-sm me-1" onclick="return confirm('Xác nhận ứng viên đã hoàn thành buổi phỏng vấn này?');">
                                                Hoàn thành
                                            </a>
                                        }
                                        else if (item.TrangThai == "Đã hoàn thành")
                                        {
                                            <a asp-controller="KetQuaTuyenDung" asp-action="KetQuaTuyenDung" asp-route-maHoSo="@item.MaHoSo" class="btn btn-warning btn-sm text-dark fw-semibold">
                                                Nhập điểm
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>