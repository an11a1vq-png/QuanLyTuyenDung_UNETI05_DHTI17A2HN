@model QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.KetQuaTuyenDung

@{
    ViewData["Title"] = " Kết Quả Tuyển Dụng";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Ghi Nhận Kết Quả Tuyển Dụng</h4>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="KetQuaTuyenDung" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Thông tin Hồ sơ / Ứng viên</label>
                    <input type="hidden" asp-for="MaHoSo" value="@ViewBag.MaHoSo" />
                    <input type="text" class="form-control bg-light" value="@ViewBag.ThongTinHoSo" readonly />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DiemDanhGia" class="form-label fw-bold">Điểm đánh giá (0 - 100)</label>
                        <input asp-for="DiemDanhGia" type="number" min="0" max="100" class="form-control" placeholder="Nhập điểm số..." />
                        <span asp-validation-for="DiemDanhGia" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="KetQua" class="form-label fw-bold">Kết quả tuyển dụng</label>
                        <select asp-for="KetQua" class="form-select">
                            <option value="Trúng tuyển">Trúng tuyển</option>
                            <option value="Không trúng tuyển">Không trúng tuyển</option>
                        </select>
                        <span asp-validation-for="KetQua" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NhanXet" class="form-label fw-bold">Nhận xét đánh giá</label>
                    <textarea asp-for="NhanXet" class="form-control" rows="4" placeholder="Nhập nhận xét về thái độ, kỹ năng chuyên môn của ứng viên..."></textarea>
                    <span asp-validation-for="NhanXet" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu kết quả</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}