@model IEnumerable<QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.KetQuaTuyenDung>
@* ========================================================
   Họ và tên: Hoàng Dương - MSSV: 23103100117
   Module 5: Danh sách Kết quả Tuyển dụng
   ======================================================== *@
@{
    ViewData["Title"] = "Danh sách kết quả tuyển dụng";
}
<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary fw-bold mb-1"><i class="bi bi-award me-2"></i>Kết Quả Đánh Giá Tuyển Dụng</h2>
            <p class="text-muted small mb-0">Bảng tổng hợp điểm số đánh giá chuyên môn và quyết định tuyển dụng của Hội đồng</p>
        </div>
        <div>
            <a asp-action="XuatExcel" asp-route-ketQua="@ViewBag.KetQuaFilter" asp-route-tenViTri="@ViewBag.TenViTriFilter" asp-route-tenUngVien="@ViewBag.TenUngVienFilter" class="btn btn-success shadow-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất file Excel
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Kết quả</label>
                    <select name="ketQua" class="form-select form-select-sm">
                        <option value="">-- Tất cả --</option>
                        <option value="Trúng tuyển" selected="@(ViewBag.KetQuaFilter == "Trúng tuyển")">Trúng tuyển</option>
                        <option value="Không trúng tuyển" selected="@(ViewBag.KetQuaFilter == "Không trúng tuyển")">Không trúng tuyển</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Tên ứng viên</label>
                    <input type="text" name="tenUngVien" class="form-control form-control-sm"
                           placeholder="Tìm theo tên..." value="@ViewBag.TenUngVienFilter" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Vị trí tuyển dụng</label>
                    <input type="text" name="tenViTri" class="form-control form-control-sm"
                           placeholder="Tìm theo vị trí..." value="@ViewBag.TenViTriFilter" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Từ ngày đánh giá</label>
                    <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgayFilter" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small fw-semibold mb-1">Đến ngày</label>
                    <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgayFilter" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th style="width: 70px;">Mã KQ</th>
                            <th>Ứng viên</th>
                            <th>Vị trí tuyển dụng</th>
                            <th style="width: 130px;">Điểm đánh giá</th>
                            <th style="width: 140px;">Kết luận</th>
                            <th>Nhận xét hội đồng</th>
                            <th style="width: 130px;">Ngày đánh giá</th>
                            <th style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@item.MaKetQua</td>
                                    <td>
                                        <div class="fw-bold text-primary">@item.HoSoUngTuyen?.UngVien?.HoTen</div>
                                        <small class="text-muted">Mã hồ sơ: #@item.MaHoSo</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.HoSoUngTuyen?.ViTriTuyenDung?.TenViTri</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary fs-6 px-3 py-1">@item.DiemDanhGia.ToString("0.0") / 100</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.KetQua == "Trúng tuyển")
                                        {
                                            <span class="badge bg-success fs-6 px-3 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Trúng tuyển
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6 px-3 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Không trúng tuyển
                                            </span>
                                        }
                                    </td>
                                    <td style="max-width: 300px;">
                                        <div class="text-truncate" title="@item.NhanXet">
                                            @(string.IsNullOrWhiteSpace(item.NhanXet) ? "Không có nhận xét." : item.NhanXet)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @item.NgayCapNhat.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.MaKetQua" class="btn btn-sm btn-outline-warning text-dark fw-semibold">
                                            <i class="bi bi-pencil"></i> Sửa điểm
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có kết quả đánh giá tuyển dụng nào được ghi nhận.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
