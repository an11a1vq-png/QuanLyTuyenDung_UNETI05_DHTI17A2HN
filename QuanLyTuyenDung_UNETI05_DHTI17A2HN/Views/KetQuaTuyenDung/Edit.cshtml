@model QuanLyTuyenDung_UNETI05_DHTI17A2HN.Models.KetQuaTuyenDung
@* ========================================================
   Họ và tên: Hoàng Dương - MSSV: 23103100117
   Module 5: Chỉnh sửa Kết quả Tuyển dụng
   ======================================================== *@
@{
    ViewData["Title"] = "Chỉnh Sửa Kết Quả Tuyển Dụng";
}
<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Chỉnh Sửa Kết Quả Phỏng Vấn</h4>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaKetQua" />
                <input type="hidden" asp-for="MaHoSo" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Thông tin Hồ sơ / Ứng viên</label>
                    <input type="text" class="form-control bg-light" value="@ViewBag.ThongTinHoSo" readonly />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DiemDanhGia" class="form-label fw-bold">Điểm đánh giá (0 - 100)</label>
                        <input asp-for="DiemDanhGia" type="number" step="0.5" min="0" max="100" class="form-control" placeholder="Nhập điểm..." required />
                        <span asp-validation-for="DiemDanhGia" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="KetQua" class="form-label fw-bold">Quyết định kết quả</label>
                        <select asp-for="KetQua" class="form-select">
                            <option value="Trúng tuyển">Trúng tuyển</option>
                            <option value="Không trúng tuyển">Không trúng tuyển</option>
                        </select>
                        <span asp-validation-for="KetQua" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="NhanXet" class="form-label fw-bold">Nhận xét của hội đồng phỏng vấn</label>
                    <textarea asp-for="NhanXet" class="form-control" rows="4" placeholder="Đánh giá kỹ năng chuyên môn, thái độ, sự phù hợp với văn hóa công ty..." required></textarea>
                    <span asp-validation-for="NhanXet" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-circle"></i> Cập nhật kết quả</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
