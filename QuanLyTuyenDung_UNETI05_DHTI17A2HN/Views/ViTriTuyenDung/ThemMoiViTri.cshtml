@*
    Họ và tên: Lê Gia Bảo
    Mã sinh viên: 23103100100
    Module: 2 - Quản lý vị trí tuyển dụng
    Nội dung: Màn hình thêm mới vị trí tuyển dụng
*@
@model QuanLyTuyenDung_UNETI05_DHTI17A2HN.ViewModels.ViTriTuyenDungFormViewModel

@{
    ViewData["Title"] = "Thêm mới vị trí tuyển dụng";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="DanhSachViTri">Vị trí tuyển dụng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm mới vị trí tuyển dụng</h4>
        </div>
        <div class="card-body">
            <form asp-action="ThemMoiViTri" method="post">
                <partial name="_FormViTri" model="Model" />
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu vị trí</button>
                    <a asp-action="DanhSachViTri" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
